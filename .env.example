# Neon Postgres — copy both connection strings from the Neon dashboard
# (Connect → "Pooled connection" on / off). Use sslmode=verify-full.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Direct (unpooled) endpoint, used by drizzle-kit for schema pushes. Optional.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full

ADMIN_EMAIL=admin@bloodbank.local
ADMIN_PASSWORD=changeme_in_production
# At least 32 characters; generate with: openssl rand -base64 32
SESSION_SECRET=your-32-char-random-secret-here
